# Place and model files (code lives in src/; Rojo rebuilds the place)
*.rbxl
*.rbxlx
*.rbxm
*.rbxmx

# Roblox Studio lock files
*.rbxl.lock
*.rbxlx.lock

# Rojo
sourcemap.json

# Wally packages (restored with `wally install`)
/Packages/
/ServerPackages/
/DevPackages/

# Secrets (Open Cloud API keys, env files)
.env
.env.*
*.key

# OS / editor junk
Thumbs.db
desktop.ini
.DS_Store
.vscode/

# Raw screen recordings (too big for the repo; GIFs are made from them)
docs/media/*.mp4
